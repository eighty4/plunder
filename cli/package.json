{
  "name": "@eighty4/plunder",
  "version": "0.0.8",
  "author": "Adam McKee <adam.be.g84d@gmail.com>",
  "repository": "https://github.com/eighty4/plunder",
  "homepage": "https://github.com/eighty4/plunder",
  "keywords": [
    "cli",
    "qa",
    "webdev",
    "web development",
    "css",
    "html",
    "automation",
    "playwright"
  ],
  "description": "Webpage QA tooling powered by Playwright",
  "license": "BSD-2-Clause",
  "type": "module",
  "bin": "./lib_js/plunder.js",
  "scripts": {
    "build": "tsc --build",
    "postbuild": "./prepare-dist.sh"
  },
  "dependencies": {
    "@eighty4/plunder-core": "workspace:^",
    "nopt": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eighty4/plunder-webapp": "workspace:^",
    "@types/node": "catalog:",
    "@types/nopt": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "lib/**/*.ts",
    "lib_js/**/*.js",
    "lib_types/**/*.d.ts",
    "!**/*.spec.*",
    "webapp/*",
    "CHANGELOG.md",
    "package.json",
    "README.md"
  ]
}
